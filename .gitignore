*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Configuração e segredos locais
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
**/senha_admin_inicial.txt
**/secrets/
**/secret/


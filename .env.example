# Referência para configurar o ambiente do processo. Python não carrega este arquivo automaticamente.
HOST=127.0.0.1
PORT=3002
ADMIN_NAME=admin
# ADMIN_PASSWORD pode ser omitida para gerar uma senha inicial local.
COOKIE_SECURE=0
TRUST_PROXY=0
TRUSTED_PROXY_IPS=
ALLOWED_ORIGINS=

# Groq opcional. Configure a chave real apenas no ambiente do backend.
LIA_GROQ_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
